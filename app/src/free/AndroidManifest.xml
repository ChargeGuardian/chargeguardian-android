<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Free version: remove SMS permissions — notification scanning only -->
    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:node="remove" />

    <!-- NotificationScanService stays active — user must opt in via system settings -->
    <!-- Play Store allows NotificationListenerService with explicit user consent -->

</manifest>
